rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { 
      return request.resource.data; 
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['text', 'uid', 'displayName', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /multiplayerChat/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(messageId) && isValidChatMessage(incoming());
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
      
      match /players/{playerId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
